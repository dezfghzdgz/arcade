{
  "name": "arcade-desktop",
  "productName": "Arcade",
  "version": "1.0.0",
  "description": "Arcade – quick games, solo or with friends.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "app.arcade.desktop",
    "productName": "Arcade",
    "files": ["main.js", "preload.js", "app/**/*"],
    "extraMetadata": { "main": "main.js" },
    "win": { "target": ["nsis", "portable"], "icon": "app/icon-512.png" },
    "mac": { "target": ["dmg"], "icon": "app/icon-512.png" },
    "linux": { "target": ["AppImage"], "icon": "app/icon-512.png" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
